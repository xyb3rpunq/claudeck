# Salin berkas ini menjadi .env lalu isi nilainya.
#
# JANGAN pernah commit .env, dan jangan biarkan ia ikut ke dalam image Docker:
# `next build` dengan output "standalone" menyalin .env ke .next/standalone/,
# jadi tanpa .dockerignore seluruh isinya akan terpanggang ke dalam image.

# Database (SQLite untuk dev lokal; ganti ke Postgres/Supabase/Neon di production)
# Contoh Postgres: postgresql://user:password@host:5432/claudeck?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Juga dipakai sebagai URL dasar untuk sitemap.xml dan robots.txt.
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API (server-side only, JANGAN pernah di-expose ke client)
# Ambil dari https://console.anthropic.com — pastikan saldo kreditnya terisi,
# karena tanpa saldo semua request chat gagal walau API key valid.
ANTHROPIC_API_KEY=""

# Midtrans (sandbox: https://dashboard.sandbox.midtrans.com)
# Kalau MIDTRANS_SERVER_KEY kosong, webhook menolak SEMUA notifikasi pembayaran.
# Itu disengaja: tanpa kunci, tanda tangan tidak membuktikan apa pun.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
